# Copy to .env and adjust. docker compose reads .env automatically.

# Image version from Docker Hub (m1v1n/pellet-pace): latest, or a release such as 1.2.0.
PELLET_PACE_TAG=latest

# Port on this machine.
HOST_PORT=3000

# Comma-separated addresses devices use to reach this machine (LAN IP, hostname).
TLS_HOSTS=192.168.1.20,range-pc.local

# Optional: your own certificate instead of the self-signed one. Put the PEM files in TLS_CERT_DIR
# (default ./certs, next to docker-compose.yml); it's mounted at /certs, so use /certs/... paths here.
# The key must be readable by the container user (PUID, default 1000). Restart after renewing.
#   TLS_CERT_DIR=./certs
#   TLS_CERT=/certs/fullchain.pem
#   TLS_KEY=/certs/privkey.pem

# Optional: fixed admin password for a fresh database (otherwise one is printed in the logs).
ADMIN_PASSWORD=

# Where deployment data lives. Leave unset to use the Docker volume "pellet-pace-data".
# To use a host folder instead, create it first and set the owner's ids (`id -u`, `id -g`):
#   DATA_DIR=/srv/pellet-pace
#   PUID=1000
#   PGID=1000
